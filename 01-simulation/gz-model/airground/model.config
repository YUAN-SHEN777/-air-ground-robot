<?xml version="1.0"?>
<model>
  <name>airground</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>air-ground robot project</name>
    <email>noreply@example.com</email>
  </author>
  <description>
    空-地两栖机器人：4 螺旋桨 + 2 摆臂舵机(servo_0/servo_1) + 4 轮子。
    由 robot.urdf 自动生成，供 PX4 SITL (gz_bridge) 使用。
    整机 679.86 g，推重比 3.0，悬停转速 577 rad/s（PX4 量纲 0~1000）。
  </description>
</model>
