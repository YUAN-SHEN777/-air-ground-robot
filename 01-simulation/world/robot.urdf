      <origin xyz="4.5e-7 -0.00000148 0.00414836" rpy="0 0 0"/>
      <mass value="0.00345126"/>
      <inertia ixx="0.00000256" ixy="0" ixz="0" iyy="0.00000255" iyz="0" izz="0.0000051"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link4_collision.stl"/></geometry>
      <material name="link4_color"><color rgba="0.30980392 0.30980392 0.30980392 1"/></material>
    </visual>
    <!-- [物理仿真] 螺旋桨 link4：改用薄圆盘近似 -->
    <collision>
      <origin xyz="-0.0122 -0.0060 0.0035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.007"/></geometry>
    </collision>
  </link>

  <link name="link5">
    <inertial>
      <origin xyz="-6.3e-7 9.4e-7 -0.01290743" rpy="0 0 0"/>
      <mass value="0.05268079"/>
      <inertia ixx="0.00001082" ixy="0" ixz="0" iyy="0.00001082" iyz="0" izz="0.00001792"/>
    </inertial>
    <visual>
