<?xml version="1.0"?>
<robot name="robot">
  <link name="base">
    <inertial>
      <origin xyz="-0.04666826 0.00001225 0.02272175" rpy="0 0 0"/>
      <mass value="0.12128087"/>
      <inertia ixx="0.00006449" ixy="0" ixz="-0.00003421" iyy="0.00033419" iyz="1e-8" izz="0.00030231"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_collision.stl"/></geometry>
      <material name="base_color"><color rgba="0.79215686 0.81960784 0.93333333 1"/></material>
    </visual>
    <!-- [物理仿真] 机身：原 collision 为 mesh（dartsim 不支持），改用长方体近似 -->
    <collision>
      <origin xyz="-0.0557 0 0.0422" rpy="0 0 0"/>
      <geometry><box size="0.1611 0.0695 0.0844"/></geometry>
    </collision>
  </link>

