    <!-- [物理仿真] 螺旋桨 link3：改用薄圆盘近似 -->
    <collision>
      <origin xyz="-0.0062 0.0118 0.0035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.007"/></geometry>
    </collision>
