    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/link1_collision.stl"/></geometry>
      <material name="link1_color"><color rgba="0.30980392 0.30980392 0.30980392 1"/></material>
    </visual>
    <!-- [物理仿真] 螺旋桨 link1：改用薄圆盘近似（半径 0.065，厚 0.007） -->
    <collision>
      <origin xyz="0.0128 -0.0051 0.0035" rpy="0 0 0"/>
      <geometry><cylinder radius="0.065" length="0.007"/></geometry>
    </collision>
  </link>

  <link name="link2">
