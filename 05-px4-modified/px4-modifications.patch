+	uORB::Subscription _sp_reply_sub{ORB_ID(setpoint_config_reply)};
+
+	// Publications
+	uORB::Publication<register_ext_component_request_s> _reg_req_pub{ORB_ID(register_ext_component_request)};
+	uORB::Publication<unregister_ext_component_s>       _unreg_pub{ORB_ID(unregister_ext_component)};
+	uORB::Publication<arming_check_reply_s>             _arming_check_reply_pub{ORB_ID(arming_check_reply)};
+	uORB::Publication<setpoint_config_s>                _setpoint_config_pub{ORB_ID(setpoint_config)};
+	uORB::Publication<actuator_motors_s>                _actuator_motors_pub{ORB_ID(actuator_motors)};
+	uORB::Publication<vehicle_thrust_setpoint_s>       _vehicle_thrust_sp_pub{ORB_ID(vehicle_thrust_setpoint)};
+
+	DEFINE_PARAMETERS(
+		(ParamFloat<px4::params::GD_SERVO_RATE>)   _param_servo_rate,
+		(ParamFloat<px4::params::GD_STICK_DZ>)     _param_stick_dz,    // 摇杆死区
+		(ParamFloat<px4::params::GD_ARM_MIN_DEG>)  _param_arm_thresh,  // 仅状态提示，不参与门控
+		(ParamFloat<px4::params::GD_MODE_MIN_DEG>) _param_mode_min,    // 10 路模式切换门限
+		(ParamInt<px4::params::GD_SERVO_GATE>)     _param_servo_gate,  // 门控总开关（0=台架禁用）
+		(ParamFloat<px4::params::GD_MAX_SPEED>)    _param_max_speed,
+		(ParamFloat<px4::params::GD_WHEEL_TRACK>)  _param_wheel_track,
+		(ParamFloat<px4::params::GD_YAW_GAIN>)     _param_yaw_gain,
+		(ParamFloat<px4::params::GD_MAX_OMEGA>)    _param_motor_max,
+		(ParamFloat<px4::params::GD_GEAR_RATIO>)   _param_gear_ratio,   // 64:1 行星减速器
+		(ParamFloat<px4::params::GD_WHEEL_R>)      _param_wheel_r,      // 轮半径 [m]
+		(ParamFloat<px4::params::GD_TURN_SLOW>)    _param_turn_slow,    // 转弯降速系数
+		(ParamInt<px4::params::CA_R_REV>)          _param_r_rev
+	)
+};
diff --git a/src/modules/ground_drive/module.yaml b/src/modules/ground_drive/module.yaml
new file mode 100644
index 0000000000..c0ed090751
--- /dev/null
+++ b/src/modules/ground_drive/module.yaml
@@ -0,0 +1,223 @@
+module_name: ground_drive
+parameters:
+  - group: Ground Drive
+    definitions:
+      GD_SERVO_RATE:
+        description:
+          short: Assumed servo angular rate for arm angle extrapolation
+          long: |
+            The arm angle is estimated by time-based extrapolation (there is no
+            angle sensor). This is the assumed angular rate used by the
+            estimator. Set it conservatively (slower than reality) so that the
+            estimate lags the real arm and the gate stays conservative.
+        type: float
+        unit: deg/s
+        decimal: 1
+        min: 5
+        max: 200
+        increment: 1
+        default: 40
+
+      GD_STICK_DZ:
+        description:
+          short: Stick deadzone for the ground drive mode
+          long: |
+            Normalised deadzone applied to the pitch, throttle and roll sticks
+            before they are turned into speed / yaw-rate commands.
+
+            Real sticks and the QGC virtual joystick do not return exactly to
+            zero: a resting offset of +0.12 on the throttle axis was measured,
+            which already produces 0.144 m/s of creep and a high motor RPM
+            (the wheel is behind a 64:1 reducer, so the motor spins 64x faster
+            than the wheel).
+
+            Inside the deadzone the command is forced to exactly zero; outside
+            it the remaining range is rescaled to 0..1 so full deflection still
+            gives full authority.
+
+            0 = disabled.
+            Note this is applied in addition to DSHOT_3D_DEAD_L/H, which forms
+            the ESC-side deadband around the neutral DShot value.
+            Keep this the PRIMARY creep suppressor, and keep DSHOT_3D_DEAD_L/H
+            narrow (+-0.015). The pure-pivot command is only control = +-0.0825
+            (w_cmd = GD_YAW_GAIN * roll, dv = w_cmd * W/2, control = dv * gear /
+            (r * max_omega)); an ESC deadband wider than that silently kills all
+            steering while forward/backward keeps working.
+        type: float
+        unit: norm
+        decimal: 2
+        min: 0
+        max: 0.5
+        increment: 0.01
+        default: 0.15
+
+      GD_ARM_MIN_DEG:
+        description:
+          short: Arm angle used for status warnings only
+          long: |
+            The 9th output controls the arm angle (0 deg = propeller position,
+            52 deg = wheel position). This parameter is now used only for
+            status / warning messages; it does NOT gate the ground drive mode.
+            The mode gate is GD_MODE_MIN_DEG, driven by the 10th output.
+        type: float
+        unit: deg
+        decimal: 1
+        min: 0
+        max: 55
+        increment: 0.5
+        default: 30
+
+      GD_MODE_MIN_DEG:
+        description:
+          short: Minimum mode-switch angle to enable ground drive
+          long: |
+            The 10th output controls the flight/ground mode switch:
+              45 deg  = air mode (propellers engaged)
+              135 deg = ground mode (wheels engaged)
+            Ground drive is allowed only after the estimated mode-switch angle
+            reaches this threshold. The estimator is open-loop (no feedback),
+            using GD_SERVO_RATE and the commanded 10th-channel value.
+        type: float
+        unit: deg
+        decimal: 1
+        min: 45
+        max: 180
+        increment: 0.5
+        default: 135
+
+      GD_SERVO_GATE:
+        description:
+          short: Enable the mode-switch gate
+          long: |
+            Master switch for both mode-switch gates:
+              - arming_check_reply.can_arm_and_run (mode entry / arming)
+              - manualDrive() output gate (motors forced to 0)
+
+            When enabled (default) the 10th output (mode switch) must reach
+            GD_MODE_MIN_DEG before the ground drive mode can be armed, entered,
+            or drive the wheel motors. The 9th output (arm angle) is not used
+            for gating.
+
+            Set this to 0 ONLY for bench debugging while the mode-switch servo
+            is not wired or not calibrated: the gate is then ignored completely
+            and the wheel motors are driven even in air mode. ALWAYS remove the
+            propellers and lift the vehicle off the ground. Restore to 1 before
+            any real operation.
+        type: enum
+        values:
+          0: Disabled (bench debug only)
+          1: Enabled
+        default: 1
+
+      GD_MAX_SPEED:
+        description:
+          short: Maximum ground speed at full throttle
+          long: |
+            Limited by GD_MAX_OMEGA / GD_GEAR_RATIO * GD_WHEEL_R once the
+            normalised command saturates at 1.0.
+        type: float
+        unit: m/s
+        decimal: 2
+        min: 0.1
+        max: 5.0
+        increment: 0.05
+        default: 1.2
+
+      GD_WHEEL_TRACK:
+        description:
+          short: Distance between left and right wheels
+          long: |
+            Distance between the two arm axes. Measured from robot.urdf:
+            joint3/joint5 are at y = -0.0825, joint4/joint6 at y = +0.0825,
+            so the default is 0.165 m.
+        type: float
+        unit: m
+        decimal: 3
+        min: 0.05
+        max: 2.0
+        increment: 0.005
+        default: 0.165
+
+      GD_YAW_GAIN:
+        description:
+          short: Steering stick to yaw rate gain
+          long: |
+            Steering follows the official rover convention: the roll stick
+            (right stick horizontal). Verify the QGC joystick mapping before use.
+        type: float
+        decimal: 1
+        min: 0.1
+        max: 5.0
+        increment: 0.1
+        default: 1.5
+
+      GD_MAX_OMEGA:
+        description:
+          short: Motor shaft angular velocity at full actuator output
+          long: |
+            Normalisation constant for wheel commands: control = v * gear /
+            (wheel_r * GD_MAX_OMEGA).
+
+            MUST match <wheel_max_omega> in the Gazebo AirGroundMux plugin,
+            otherwise commanded speed != actual speed. The value is higher than
+            the propeller's <motor_max_omega> on purpose: props and wheels share
+            the same motor channel, and the prop omega_max is locked by the
+            thrust calibration (T = kT*w^2), so the wheel side gets its own
+            scale. Wheel top speed = GD_MAX_OMEGA / gear * wheel_r.
+        type: float
+        unit: rad/s
+        decimal: 0
+        min: 10
+        max: 10000
+        increment: 1
+        default: 2400
+
+      GD_GEAR_RATIO:
+        description:
+          short: Gear ratio between motor and wheel
+          long: |
+            Planetary reducer on the ground side. Wheel angular velocity =
+            motor angular velocity / gear ratio.
+        type: float
+        decimal: 1
+        min: 1
+        max: 200
+        increment: 1
+        default: 64
+
+      GD_WHEEL_R:
+        description:
+          short: Wheel radius
+          long: |
+            Used to convert wheel linear speed to motor shaft angular velocity.
+            Measured from robot.urdf (collision cylinder radius = 0.040 m).
+        type: float
+        unit: m
+        decimal: 4
+        min: 0.005
+        max: 0.5
+        increment: 0.001
+        default: 0.04
+
+      GD_TURN_SLOW:
+        description:
+          short: Throttle cut at full steering
+          long: |
+            Skid-steer needs differential authority to turn. With W=0.165 m and
+            L=0.21 m (W/L = 0.79) this frame loses more yaw moment to lateral
+            scrub than the wheels can generate, so longitudinal speed is scaled
+            by (1 - GD_TURN_SLOW * |roll|).
+
+            1.0 = full steering zeroes the longitudinal command completely,
+                  i.e. pure pivot. Measured 2026-10-18 (3 s, |dyaw| > 10 deg):
+                    v = 0.60 m/s -> 0/5 turn
+                    v = 0.45 m/s -> 2/10
+                    v = 0.00 m/s -> 2/10 (best)
+            0.0 = disabled (keep full speed while steering).
+            Straight driving is unaffected (|roll| = 0 -> factor 1).
+        type: float
+        decimal: 2
+        min: 0.0
+        max: 1.0
+        increment: 0.05
+        default: 1.0
