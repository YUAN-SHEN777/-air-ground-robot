index 0000000000..88c655d681
--- /dev/null
+++ b/ROMFS/px4fmu_common/init.d-posix/airframes/4030_gz_airground
@@ -0,0 +1,159 @@
+. ${R}etc/init.d/rc.mc_defaults
+
+PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
+PX4_GZ_WORLD=${PX4_GZ_WORLD:=airground}
+PX4_SIM_MODEL=${PX4_SIM_MODEL:=airground}
+
+# ⚠️⚠️ 这里为什么用 param set（强制），而不是 param set-default？ ⚠️⚠️
+#
+#   param set-default  =「只在参数【还没有值】时才写入」
+#   而 PX4 SITL 会把参数【持久化】到 build/px4_sitl_default/rootfs/parameters.bson
+#   → 只要 bson 里已经有这个参数（比如某次调试时运行时改过），
+#     airframe 里的 set-default 就【永远不再生效】，表现为
+#     “代码明明改了，跑起来却没变化”（踩过两次）。
+#
+#   所以：【机体接口类】参数一律用 param set 强制覆盖，保证每次启动都是对的。
+#         【性能调参类】（如 MPC_THR_HOVER）保留 set-default，允许用户覆盖微调。
+
+# ==================== 接口使能 ====================
+param set SIM_GZ_EN 1
+
+# ==================== 多旋翼控制分配 ====================
+param set CA_AIRFRAME 0
+param set CA_ROTOR_COUNT 4
+
+# 桨0 前左 (joint3 -> link1)
+param set CA_ROTOR0_PX +0.1008
+param set CA_ROTOR0_PY +0.1100
+param set CA_ROTOR0_KM +0.05
+
+# 桨1 前右 (joint4 -> link2)
+param set CA_ROTOR1_PX +0.1008
+param set CA_ROTOR1_PY -0.1100
+param set CA_ROTOR1_KM -0.05
+
+# 桨2 后左 (joint5 -> link3)
+param set CA_ROTOR2_PX -0.1092
+param set CA_ROTOR2_PY +0.1100
+param set CA_ROTOR2_KM -0.05
+
+# 桨3 后右 (joint6 -> link4)
+param set CA_ROTOR3_PX -0.1092
+param set CA_ROTOR3_PY -0.1100
+param set CA_ROTOR3_KM +0.05
+
+# ==================== 桨通道：单向推力 ====================
+# ⚠️ 必须显式写死（不能用默认值）：PX4 SITL 会把参数持久化到
+#    build/px4_sitl_default/rootfs/parameters.bson。若之前调试时留过
+#    CA_R_REV=15，这里不强制覆盖就会沿用旧值，表现为偏航异常。
+#
+#    CA_R_REV 是【通道级】双向标志，桨和轮共用 CA_ROTOR0..3：
+#      · 轮只有地面模式才需要双向（由 AirGroundMux 用 zero_offset=500 解码）
+#      · 桨只需要单向 0..1 推力，零推力点在 0
+#    所以飞行侧固定 REV=0 + DIS=0；轮的换向交给 mux 自己处理。
+#
+# 当前取值：CA_R_REV=15  EC_DIS=500（由环境变量 CA_R_REV / EC_DIS 控制）
+param set CA_R_REV 15
+param set SIM_GZ_EC_DIS1 500
+param set SIM_GZ_EC_DIS2 500
+param set SIM_GZ_EC_DIS3 500
+param set SIM_GZ_EC_DIS4 500
+
+# ==================== 传感器使能 ====================
+param set SENS_EN_MAGSIM 0
+
+# ==================== 仿真环境配置（解锁必需）====================
+# 实测教训：不加这两行，ARM 命令虽然回 ACCEPTED，
+#           但 HEARTBEAT 的解锁位始终是 False —— 飞机根本没解锁。
+#           后果极其隐蔽：gz_bridge 里 _armed.armed=false → 所有输出取
+#           DIS 值 → 舵机永远停在 DIS 位，看起来像【机构卡死】。
+#
+# 根因在 commander 的 modeCheck：
+#   if (manual_control_signal_lost && mode_req_manual_control != 0) {
+#       ... reporter.clearArmingBits(mode_req_manual_control);   # 无条件执行
+#   }
+# 开机默认 Position 模式【需要摇杆】，仿真里既无遥控器也没摇杆
+# → 该模式被 clearArmingBits 移出可解锁集合 → 解锁被拒。
+#
+# COM_RC_IN_MODE=1 = MAVLink only，禁用 RC 及相关解锁前检查。
+# QGC 的虚拟摇杆走 MANUAL_CONTROL（就是 MAVLink），所以这个值不冲突。
+param set COM_RC_IN_MODE 1
+
+# 数据链丢失保护：纯仿真无真实数传链路，关掉（默认即 0，显式写出防污染）
+param set NAV_DLL_ACT 0
+
+# ==================== 悬停油门（性能调参类，保留 set-default）====================
+# PX4 默认 MPC_THR_HOVER=0.5，但我们的实际悬停油门是 1/sqrt(TWR)。
+# TWR=3 时 = 1/sqrt(3) = 0.577。不设的话 PX4 会以为 50% 就该悬停，
+# 结果起飞油门爬到 575 就停住，机器人抬不起来。
+param set-default MPC_THR_HOVER 0.5774
+
+# ==================== ESC / 舵机 功能映射 ====================
+# 电机输出 1~4 → Gazebo 侧 4 个 MulticopterMotorModel
+param set SIM_GZ_EC_FUNC1 101
+param set SIM_GZ_EC_FUNC2 102
+param set SIM_GZ_EC_FUNC3 103
+param set SIM_GZ_EC_FUNC4 104
+
+# ==================== 9 路摆臂角 / 10 路模式切换 ====================
+# 功能编号（来自 PX4 的 output_functions.yaml）：
+#   201~215 = Servo 1~15      ← 由 uORB actuator_servos 驱动（多旋翼下是 NaN）
+#   301~306 = Peripheral_via_Actuator_Set 1~6 ← 由 MAV_CMD_DO_SET_ACTUATOR 驱动 ✅
+#   407~412 = RC_AUX1~6       ← 由 manual_control_setpoint.aux1~6 驱动
+# 默认选 301：可直接用 DO_SET_ACTUATOR 控制，简单且可脚本化。
+# 用 SERVO_SRC=aux1 可改成 407，让舵机跟随一个连续通道（滑条/手柄）。
+param set SIM_GZ_SV_FUNC1 301
+#
+#   9 路（servo_0）= 摆臂角；10 路（servo_1）= 飞行/地面模式切换。
+#   实机两个舵机完全解耦：1 号管摆臂角（0.7 N·m + 20:1 蜗轮蜗杆），
+#   2 号管模式切换（45° = 空中，135° = 地面）。
+#   仿真里 servo_0 / servo_1 两个摆臂关节仍共用 /servo_0，只复现摆臂角。
+param set SIM_GZ_SV_FUNC2 302
+
+# 输入值域：注意！SIM_GZ_SV_MIN/MAX/DIS/FAIL 是【0~1000 的整数】，不是 [-1,1]！
+#   源码 module.yaml 的 standard_params 定义：
+#       disarmed {min:0, max:1000, default:500}
+#       min      {min:0, max:1000, default:0}
+#       max      {min:0, max:1000, default:1000}
+#       failsafe {min:0, max:1000}
+#   mixer_module.cpp 的 updateParams() 用 param_get(..., &int32_t) 读取，
+#   越界（比如写 -1）会被拒 → 回落成上面那个 default。
+#
+# 两层映射（务必分清）：
+#   第 1 层  mixer_module（-> outputs[i]，范围 [0,1000]）：
+#       收到 DO_SET_ACTUATOR:  outputs = interpolate(param1, -1,1,  MIN1, MAX1)
+#       没收到命令（NAN）  :  outputs = DIS1
+#   第 2 层  GZMixingInterfaceServo（-> 关节角度）：
+#       angle = MINA1 + (MAXA1-MINA1) * (outputs - MIN1) / (MAX1 - MIN1)
+#
+# 所以取 MIN1=0 / MAX1=1000，第 1 层就是恒等变换，查表最直观：
+#       param1 = -1  ->  outputs=0    -> angle = 0°
+#       param1 =  0  ->  outputs=500  -> angle = 26°
+#       param1 = +1  ->  outputs=1000 -> angle = 52°
+param set SIM_GZ_SV_MIN1  0
+param set SIM_GZ_SV_MAX1  1000
+
+# 角度范围（度）—— 对应 URDF 里摆臂的 0 ~ 0.9076 rad
+param set SIM_GZ_SV_MINA1 0
+param set SIM_GZ_SV_MAXA1 52
+
+# 未解锁 → outputs = DIS1 = 0 → angle = MINA1 = 0°（摆臂水平 = 飞行安全位）
+# 失效保护 → 同上，也停在 0°
+param set SIM_GZ_SV_DIS1  0
+param set SIM_GZ_SV_FAIL1 0
+
+# ── 10 路模式切换：45° = 空中，135° = 地面 ──
+#   DO_SET_ACTUATOR(187) param2 = -1 → 45°；+1 → 135°
+param set SIM_GZ_SV_MIN2  0
+param set SIM_GZ_SV_MAX2  1000
+param set SIM_GZ_SV_MINA2 45
+param set SIM_GZ_SV_MAXA2 135
+param set SIM_GZ_SV_DIS2  0
+param set SIM_GZ_SV_FAIL2 0
+
+# ==================== 地面驱动模块 ====================
+# GROUND_DRIVE 外部模式：摆臂摆到 52° 后从 QGC / `commander mode extN` 切进去，
+# 该模块独占 actuator_motors（飞行模式下常驻但不写电机，arming check 也不干扰）。
+# ⚠️ 若模块没编译进去（CONFIG_MODULES_GROUND_DRIVE=n），
+#    这一行只会打印 unknown command，不影响其它启动流程。
+ground_drive start
