<sdf version='1.11'>
  <model name='airground'>
    <self_collide>false</self_collide>
    <pose>0 0 0.05 0 0 0</pose>
    <link name='base_link'>
      <inertial>
        <pose>-0.046668260000000003 1.225e-05 0.022721749999999999 0 0 0</pose>
        <mass>0.12128087</mass>
        <inertia>
          <ixx>6.4490000000000001e-05</ixx>
          <ixy>0</ixy>
