    <!-- 空-地（机械切换）仿真器：摆臂 >= 48 度时把电机命令送给轮子并让桨停，
         飞行位则原样转发给桨。源码见 px4_changes/gz_plugins/airground_mux/。
         filename 用绝对路径（libairground_mux.so 由 install_sim_plugin.sh 拷贝）。 -->
    <plugin name='airground::AirGroundMux' filename='/home/yuan/PX4-Autopilot/Tools/simulation/gz/models/airground/libairground_mux.so'>
      <servo_joint>servo_0</servo_joint>
      <arm_threshold_deg>48</arm_threshold_deg>
      <wheel_joints>joint7 joint8 joint9 joint10</wheel_joints>
      <wheel_signs>1 1 1 1</wheel_signs>
      <gear_ratio>64</gear_ratio>
      <motor_max_omega>1000</motor_max_omega>
      <wheel_max_omega>2400</wheel_max_omega>
      <zero_offset>500</zero_offset>
      <half_span>500</half_span>
      <prop_zero_offset>500</prop_zero_offset>
    </plugin>
